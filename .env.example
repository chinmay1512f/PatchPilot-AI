# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=your_api_key_here

# Claude model and reasoning effort (low | medium | high | xhigh | max)
PATCHPILOT_MODEL=claude-opus-5-5
PATCHPILOT_EFFORT=high
# Server-side refusal fallback (recommended)
PATCHPILOT_REFUSAL_FALLBACK=true
# Claude fast mode (research preview): up to ~2.5x faster responses at 2x token price; falls back automatically
PATCHPILOT_FAST_MODE=true
# live | record | replay   (replay re-uses a recorded run; UI labels it clearly)
PATCHPILOT_LLM_MODE=live
PATCHPILOT_JOB_TOKEN_BUDGET=600000

# Execution sandbox: auto | docker | local | disabled
#   auto   -> Docker if the sandbox image exists, otherwise restricted local
#             execution ONLY when the user ticks "I trust this repository"
PATCHPILOT_EXECUTION_BACKEND=auto
PATCHPILOT_DOCKER_IMAGE=patchpilot-sandbox:latest
PATCHPILOT_SANDBOX_TIMEOUT_SECONDS=120
PATCHPILOT_SANDBOX_MEMORY_MB=1024
PATCHPILOT_SANDBOX_MAX_PROCESSES=16

# Workflow limits
PATCHPILOT_MAX_REPAIR_ATTEMPTS=2
PATCHPILOT_MAX_UPLOAD_MB=25

# Scanners
PATCHPILOT_OSV_ENABLED=true
PATCHPILOT_DISABLED_SCANNERS=
# Re-run Semgrep on the patched files after a fix (slow start on Windows, ~20s). Off = Bandit + secret + malware rules
# re-check the changed files; Semgrep still scans the whole repository in the parallel security lane.
PATCHPILOT_PATCH_RECHECK_SEMGREP=false

# --- Public deployment (see docs/DEPLOY.md); leave unset for local use ---
# PATCHPILOT_MAX_JOBS_PER_HOUR=5
# PATCHPILOT_MAX_JOBS_PER_DAY=25
# PATCHPILOT_MAX_CONCURRENT_JOBS=1
# PATCHPILOT_CORS_ORIGIN_REGEX=^https://[A-Za-z0-9-]+\.vercel\.app$
# PATCHPILOT_SANDBOX_UID=10001        # Linux container only; server must run as root
# Frontend build (Vercel): VITE_API_BASE=https://<your-render-service>.onrender.com
